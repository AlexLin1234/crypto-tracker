# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Symbols -----------------------------------------------------------------
# Internal canonical symbols. Per-exchange symbol mapping lives in the
# connector, not here, because each venue spells these differently
# (Kraken: BTC/USD, Coinbase: BTC-USD, Binance.US: BTCUSD).
XSTREAM_SYMBOLS=BTC-USD,ETH-USD

# --- Redpanda (Milestone 1) --------------------------------------------------
REDPANDA_BROKERS=localhost:19092
TOPIC_TRADES_RAW=trades.raw
TOPIC_ORDERBOOK_RAW=orderbook.raw
TOPIC_DIVERGENCE_EVENTS=divergence.events

# --- Storage (Milestone 3+) --------------------------------------------------
PARQUET_ROOT=./data/lake
CHECKPOINT_ROOT=./checkpoints

# --- Exchange credentials ----------------------------------------------------
# The two feeds targeted by Milestone 0 (Kraken v2, Coinbase Exchange) are
# PUBLIC and require no auth. These are placeholders only in case the project
# later needs Coinbase Advanced Trade, which requires CDP keys with JWT signing.
# Leave blank unless that path is actually taken.
COINBASE_CDP_API_KEY_NAME=
COINBASE_CDP_PRIVATE_KEY=

# --- Networking --------------------------------------------------------------
# Optional. Only set if you are behind an HTTP CONNECT proxy. Leave blank on a
# normal machine. See docs/CONNECTIVITY.md.
XSTREAM_WS_PROXY=
